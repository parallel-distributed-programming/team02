    {
      "id": "3354c1fc-5d5b-41b4-bedc-041129765212",
      "body": "Cornell box\u3084Moller-Trumbore\u306b\u3064\u3044\u3066\u3001reference\u306a\u3069\u306f\u3064\u3051\u308b\u3079\u304d\u3067\u3057\u3087\u3046\u304b\uff1f",
